{
  "title": "Registry Stats",
  "uid": "registry-stats",
  "description": "Docker Hub and GHCR image download tracking via Prometheus metrics",
  "tags": ["registry", "docker", "ghcr", "downloads"],
  "timezone": "browser",
  "refresh": "1h",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Mimir", "value": "mimir" },
        "hide": 0
      },
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(registrystats_image_pulls_total, repo)",
        "includeAll": true,
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"] },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "registry",
        "label": "Registry",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(registrystats_image_pulls_total, registry)",
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "Total Downloads",
      "description": "Sum of all downloads across all tracked packages and registries",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": 0 },
              { "color": "green", "value": 1000 },
              { "color": "yellow", "value": 100000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(registrystats_image_pulls_total{repo=~\"$repo\",registry=~\"$registry\"})",
          "legendFormat": "Total",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Tracked Packages",
      "description": "Number of unique packages being tracked",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": 0 }]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(registrystats_image_pulls_total{repo=~\"$repo\",registry=~\"$registry\"})",
          "legendFormat": "Packages",
          "instant": true
        }
      ]
    },
    {
      "id": 1,
      "title": "Package Overview",
      "description": "Downloads per package",
      "type": "table",
      "gridPos": { "h": 10, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "repo" },
            "properties": [{ "id": "displayName", "value": "Package" }]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "displayName", "value": "Total Downloads" }]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "displayName": "Total Downloads", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "registrystats_image_pulls_total{repo=~\"$repo\",registry=~\"$registry\"}",
          "legendFormat": "{{owner}}/{{repo}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "owner": true, "hostname": true, "__tenant_id__": true },
            "renameByName": { "registry": "Registry", "repo": "Package", "Value": "Downloads" }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Cumulative Downloads",
      "description": "Total download count over time per repo",
      "type": "timeseries",
      "gridPos": { "h": 13, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "registrystats_image_pulls_total{repo=~\"$repo\",registry=~\"$registry\"}",
          "legendFormat": "{{repo}} ({{registry}})"
        }
      ]
    },
    {
      "id": 3,
      "title": "Daily Download Delta",
      "description": "New downloads per day per repo",
      "type": "timeseries",
      "gridPos": { "h": 13, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        }
      },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "delta(registrystats_image_pulls_total{repo=~\"$repo\",registry=~\"$registry\"}[1d])",
          "legendFormat": "{{repo}} ({{registry}})",
          "interval": "1d"
        }
      ]
    }
  ],
  "schemaVersion": 42,
  "version": 2
}
